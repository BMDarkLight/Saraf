# ---- LLM: any OpenAI-compatible endpoint (OpenAI, OpenRouter, Together, vLLM, Ollama, ...)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
# Set to false if your provider doesn't support streamed tool calls
LLM_STREAM=true
# Set to true for local models whose chat template chokes on enum/anyOf (e.g. Gemma in LM Studio)
LLM_COMPAT_SCHEMAS=false

# ---- Venue: where orders go and what the dashboard shows by default (see backend/saraf/venues)
# wallex | tse   (tools and API endpoints can still read any venue by name)
DEFAULT_VENUE=wallex

# ---- Venue credentials. Each venue keeps its own prefix; data-only venues (tse) need none.
# Wallex (needed only for live spot trading / real balances)
WALLEX_API_KEY=
# Trade-credit (challenge) account: its clientId from GET /sub-accounts; empty = main account
WALLEX_SUB_ACCOUNT_CLIENT_ID=
# Futures endpoints aren't in the public docs; leave empty and use paper mode
WALLEX_FUTURES_BASE_URL=

# ---- Modes: paper simulates fills on the venue's live order book; live sends real orders
SPOT_MODE=paper
FUTURES_MODE=paper
REQUIRE_CONFIRMATION=true

# ---- Risk limits
MAX_ORDER_NOTIONAL_USDT=500
MAX_ORDER_NOTIONAL_TMN=50000000
MAX_LEVERAGE=10
MAX_OPEN_POSITIONS=10
SYMBOL_ALLOWLIST=

# ---- Paper starting balances
PAPER_USDT=1000
PAPER_TMN=100000000

# ---- Optional: better web search (falls back to DuckDuckGo)
TAVILY_API_KEY=

# ---- Autonomous trading engine (built for the Wallex AI trading challenge) — see docs/hackathon/
# backtest | shadow | live  (live also needs the --confirm-live flag)
ENGINE_MODE=shadow
# ai | rules  (rules = baseline without the LLM)
ENGINE_DECIDER=ai
# empty = use LLM_MODEL
ENGINE_LLM_MODEL=
# optional own endpoint/key for the engine, so chat usage can't exhaust its budget
ENGINE_LLM_BASE_URL=
ENGINE_LLM_API_KEY=
# JSON added to LLM requests; thinking models must answer directly, e.g. Qwen on GapGPT:
# ENGINE_LLM_EXTRA_BODY={"reasoning_effort": "none"}
ENGINE_LLM_EXTRA_BODY=
ENGINE_CAPITAL_TMN=5000000
# the challenge's allowed markets, comma-separated (empty = no restriction)
ENGINE_ALLOWED_MARKETS=
# markets never traded: "credit" = those disabled on trade-credit accounts, or a comma list
ENGINE_BLOCKED_MARKETS=credit
ENGINE_UNIVERSE=auto
# per side; read the real rate from /v1/account/fee of the challenge account
ENGINE_FEE_RATE=0.0025
# ISO UTC challenge end, e.g. 2026-11-01T20:30:00Z; everything is sold to TMN before it
ENGINE_END_TIME=
ENGINE_MAX_POSITIONS=3
ENGINE_MAX_POSITION_PCT=0.25
ENGINE_RISK_PER_TRADE_PCT=0.01
ENGINE_DRAWDOWN_PAUSE_PCT=0.06
ENGINE_DRAWDOWN_STOP_PCT=0.12
