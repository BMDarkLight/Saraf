# The strategy session (docs/STRATEGY.md), loaded after the server's .env by saraf-strategy.service.
# Shadow only: real market data, simulated fills, no orders. Tracked in git; no secrets here.
ENGINE_QUOTE=USDT
ENGINE_CORE_ENABLED=true
ENGINE_UNIVERSE=auto
ENGINE_UNIVERSE_SIZE=10
ENGINE_FEE_RATE=0.0013
ENGINE_MAKER_FEE_RATE=0.001
# Satellite limits from the research (docs/STRATEGY.md). Wallex's USDT-market minimum order is 1 USDT (/v1/markets),
# ~330k TMN with the engine's 1.2x margin, so a 12.5% position (~625k TMN) is above it. The UI's tuning tab overrides these.
ENGINE_MAX_EXPOSURE_PCT=0.30
ENGINE_MAX_POSITION_PCT=0.125
ENGINE_MAX_POSITIONS=3
ENGINE_RISK_PER_TRADE_PCT=0.01
ENGINE_MIN_ATR_PCT=0.15
ENGINE_DIP_ATR=2
ENGINE_SETUPS=dip_in_uptrend
