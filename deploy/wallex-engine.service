[Unit]
Description=Wallex autonomous trading engine
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/wallex-agent/backend
EnvironmentFile=/opt/wallex-agent/.env
# the UI's live/shadow toggle writes this (data/ survives deploys); it overrides ENGINE_RUN_ARGS in .env
EnvironmentFile=-/opt/wallex-agent/data/engine/mode.env
# the strategy card's real-mode switch copies deploy/strategy.env here (absent = default TMN-market settings)
EnvironmentFile=-/opt/wallex-agent/data/engine/profile.env
# the challenge window (deploy/challenge.env, tracked in git) is loaded last so a push can move it
EnvironmentFile=-/opt/wallex-agent/deploy/challenge.env
Environment=PYTHONUNBUFFERED=1 TZ=UTC
# ENGINE_RUN_ARGS lives in the server's .env: "--mode shadow", or "--mode live --confirm-live" for the challenge
ExecStart=/root/.local/bin/uv run --no-dev python -m wallex_agent.engine run $ENGINE_RUN_ARGS
Restart=always
RestartSec=20

[Install]
WantedBy=multi-user.target
