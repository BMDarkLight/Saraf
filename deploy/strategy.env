# The strategy session (docs/STRATEGY.md), loaded after the server's .env by wallex-strategy.service.
# Shadow only: real market data, simulated fills, no orders. Tracked in git; no secrets here.
ENGINE_QUOTE=USDT
ENGINE_CORE_ENABLED=true
ENGINE_UNIVERSE=auto
ENGINE_UNIVERSE_SIZE=10
ENGINE_FEE_RATE=0.0013
ENGINE_MAKER_FEE_RATE=0.001
# 5M TMN is only ~26 USDT and Wallex's USDT-market minimum is 5 USDT: one satellite trade is at least ~1.14M TMN (23%).
# At 30% x 0.67 (neutral regime) = 20% exposure and a 12.5% cap no order could ever be placed. 50% leaves room for one
# position in a neutral regime and two in risk_on; the loss at the stop stays within ENGINE_RISK_PER_TRADE_PCT.
ENGINE_MAX_EXPOSURE_PCT=0.50
ENGINE_MAX_POSITION_PCT=0.25
ENGINE_MAX_POSITIONS=2
ENGINE_RISK_PER_TRADE_PCT=0.01
