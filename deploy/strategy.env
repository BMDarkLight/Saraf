# The strategy session (docs/STRATEGY.md), loaded after the server's .env by wallex-strategy.service.
# Shadow only: real market data, simulated fills, no orders. Tracked in git; no secrets here.
ENGINE_QUOTE=USDT
ENGINE_CORE_ENABLED=true
ENGINE_UNIVERSE=auto
ENGINE_UNIVERSE_SIZE=10
ENGINE_FEE_RATE=0.0013
ENGINE_MAKER_FEE_RATE=0.001
# 5M TMN is only ~18 USDT (USDT/TMN ~273k) and Wallex's USDT-market minimum is 5 USDT: one satellite trade is at least
# 1.2 x 5 USDT = ~1.64M TMN (33%). At 30% x 0.67 (neutral regime) = 20% exposure and a 12.5% cap no order could ever be
# placed. 50% x 0.67 leaves room for one minimum-size position in a neutral regime; the risk manager takes the exchange
# minimum when its loss at the stop stays within ENGINE_RISK_PER_TRADE_PCT. The UI's tuning tab overrides these.
ENGINE_MAX_EXPOSURE_PCT=0.50
ENGINE_MAX_POSITION_PCT=0.25
ENGINE_MAX_POSITIONS=2
ENGINE_RISK_PER_TRADE_PCT=0.01
